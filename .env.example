# Copy to .env.local for local dev; set the same as secrets on Fly for prod.

# Public base URL of the app (no trailing slash). Used to build the Google
# OAuth redirect URI. Local: http://localhost:3000 ; Prod: https://<app>.fly.dev
APP_URL=http://localhost:3000

# Google OAuth client (Web application) from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session secret + password fallback for the private side. Leave UNSET locally
# to skip the gate; MUST be set in production (it's also the session cookie value
# set after a successful Google sign-in).
APP_PASSWORD=

# Emails allowed to "Sign in with Google" (comma-separated). Defaults to the
# owner email in config.ts. Set both your personal + work emails here.
AUTH_ALLOWED_EMAILS=

# Where mutable state (shares, Google tokens, snapshot) is written.
# Local default is ./data ; on Fly this is the volume mount.
DATA_DIR=./data

# How often (minutes) to refresh availability from your calendar.
REGEN_INTERVAL_MIN=10

# Optional: require ?secret=… on POST /api/regenerate (for a cron/webhook ping).
REGEN_SECRET=

# Optional: enables the Stage 2 LLM refine pass (curates/orders each share's
# windows per your Settings guidance, cached per share). Unset = deterministic.
# ANTHROPIC_API_KEY=
